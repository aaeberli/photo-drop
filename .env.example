# Edge function secrets. Set them with:
#   supabase secrets set --env-file .env
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by the platform —
# do not set them yourself.

# Signs the session JWTs handed to browsers. Deliberately NOT your project's
# Supabase JWT secret: a token signed with that would also work against the
# Supabase REST API.
#   openssl rand -base64 48
SESSION_JWT_SECRET=

# Mixed into the access-key hash so a leaked database dump does not let anyone
# brute-force keys offline.
#   openssl rand -base64 32
AUTH_KEY_PEPPER=

# Guards sync-to-google (sent by pg_cron as the x-cron-secret header).
#   openssl rand -base64 32
CRON_SECRET=

# Guards google-oauth-start, which only you ever open.
# Hex, not base64: this one travels in a querystring, and base64's `+` decodes
# to a space there, so the comparison silently fails with "unauthorised".
#   openssl rand -hex 32
SETUP_SECRET=

# Google OAuth client (type: Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Album created on first mirror run. Changing this later does nothing — the
# album id is remembered in the google_oauth row.
GOOGLE_ALBUM_TITLE=Photo Drop

# CORS allowlist, comma separated. Must match your Pages origin exactly:
# no trailing slash, no path.
ALLOWED_ORIGINS=https://YOUR_USERNAME.github.io

# --- optional tuning -------------------------------------------------------

# How long a browser session lasts before the stored key is re-exchanged.
SESSION_TTL_SECONDS=43200

# Rejected above this. Must match maxUploadBytes in web/config.js and the
# `uploads` bucket file_size_limit — the bucket is the only real enforcement.
# 52428800 = 50 MB, sized for iPhone ProRAW and high-megapixel Android JPEGs.
MAX_UPLOAD_BYTES=52428800

# Google Photos mirror batching.
SYNC_BATCH_SIZE=20
SYNC_MAX_ATTEMPTS=5

# Lifetime of the signed URLs the collage renders. Long on purpose: the URL is
# cached per photo and reused on every poll, which is what lets the browser
# cache each tile instead of re-downloading it every minute.
DISPLAY_URL_TTL_SECONDS=604800

# Cap on how many photos the collage pulls into its rotation.
COLLAGE_MAX_PHOTOS=2000

# Refuse new uploads past this much stored display data. The free tier caps file
# storage at 1 GB; stopping at 800 MB leaves room for staged originals in
# transit and means guests get a clear message rather than a broken upload.
# Raise it if you are on Pro (100 GB).
DISPLAY_BUDGET_BYTES=838860800

# Upload ceilings per hour. Per-IP is the meaningful one: the guest link is a
# single key shared by everybody, so a tight per-key cap would throttle the
# whole party rather than one abuser. Deliberately generous, because a venue
# behind one NAT looks like a single uploader.
MAX_GRANTS_PER_IP=200
MAX_GRANTS_PER_KEY=2000

# Orphan sweep: how long an upload may sit uncommitted before it is treated as
# abandoned, and how many to examine per run. Do NOT raise the batch above 200
# without paginating the live-photo lookup in sweep-orphans — it decides
# "delete unless found in photos", so a truncated lookup would delete live
# photos. The value is clamped in code for that reason.
ORPHAN_GRACE_MINUTES=60
ORPHAN_BATCH_SIZE=200
